# SPDX-License-Identifier: MIT
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

# Markdown 行尾双空格是换行语义，不能 trim
[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{json,yml,yaml,cff}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf

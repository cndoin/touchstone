cff-version: 1.2.0
message: "If you use this software, please cite it as below."
type: software
title: "Touchstone: An Anti-Hallucination Engineering Kit for AI Agents"
abstract: >-
  A zero-dependency, MIT-licensed toolkit that turns anti-hallucination guidance
  from prose instructions into executable gates. It combines claim-level
  provenance enforcement, context-isolated verification, hard checks for
  decidable items (URL/DOI/file/command/package), a project decision ledger with
  drift detection, dependency hallucination and slopsquatting defense, and
  uncertainty routing — implemented as plain Python scripts using only the
  standard library, with adapters for Claude Code, DeepSeek and generic agent
  harnesses.
authors:
  - name: "Touchstone contributors"
    alias: "cndoin"
    website: "https://github.com/cndoin"
license: MIT
version: 4.2.0
date-released: "2026-09-17"
repository-code: "https://github.com/cndoin/touchstone"
url: "https://github.com/cndoin/touchstone"
keywords:
  - hallucination
  - LLM
  - factuality
  - faithfulness
  - verification
  - AI agents
  - RAG
  - slopsquatting
  - uncertainty
  - provenance
preferred-citation:
  type: software
  title: "Touchstone: An Anti-Hallucination Engineering Kit for AI Agents"
  authors:
    - name: "Touchstone contributors"
      alias: "cndoin"
      website: "https://github.com/cndoin"
  year: 2026
  version: 4.2.0
  license: MIT

